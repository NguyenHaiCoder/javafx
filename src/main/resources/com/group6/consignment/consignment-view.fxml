<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Root of the Scene, loaded by FXMLLoader in MainApp -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group6.consignment.controller.ConsignmentController"
      styleClass="page">

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <!-- Header -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="1" styleClass="badge-step"/>
            <Label text="Consignment" styleClass="title"/>
        </HBox>

        <!-- Input row -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="License Plate" styleClass="muted"/>
            <TextField fx:id="plateField" promptText="51K-234.56" prefWidth="200"/>
            <Label text="Car Type" styleClass="muted"/>
            <ComboBox fx:id="typeBox" prefWidth="170"/>
            <Button fx:id="consignBtn" text="Consign" styleClass="primary"
                    defaultButton="true" onAction="#handleConsign"/>
        </HBox>

        <TableView fx:id="carTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="plateCol" text="Plate"/>
                <TableColumn fx:id="typeCol" text="Type"/>
                <TableColumn fx:id="dateCol" text="Date"/>
                <TableColumn fx:id="timeCol" text="Time In"/>
                <TableColumn fx:id="createdCol" text="Created At"/>
                <TableColumn fx:id="updatedCol" text="Updated At"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>

        <!-- Actions on the selected row + status -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="inspectBtn" text="Inspect Selected" styleClass="success" onAction="#handleInspect"/>
            <Button fx:id="editBtn" text="Edit" onAction="#handleEdit"/>
            <Button fx:id="deleteBtn" text="Delete" styleClass="danger" onAction="#handleDelete"/>
            <Label fx:id="statusLabel" styleClass="muted"/>
        </HBox>
    </VBox>
</VBox>
