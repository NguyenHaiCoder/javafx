<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Same Scene, new root: MainApp.showInspection() swaps to this view -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group6.consignment.controller.InspectionController"
      styleClass="page">

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <!-- Header -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="2" styleClass="badge-step,green"/>
            <Label text="Inspection Checklist" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="plateBadge" styleClass="plate-badge"/>
        </HBox>

        <!-- Checklist: 2 columns x 3 rows -->
        <GridPane hgap="40" vgap="18">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <CheckBox fx:id="bodyCheck" text="Body &amp; paint"/>
            <CheckBox fx:id="mirrorsCheck" text="Mirrors" GridPane.columnIndex="1"/>
            <CheckBox fx:id="lightsCheck" text="Lights &amp; signals" GridPane.rowIndex="1"/>
            <CheckBox fx:id="tiresCheck" text="Tires" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <CheckBox fx:id="damageCheck" text="No accident or flood damage" GridPane.rowIndex="2"/>
            <CheckBox fx:id="keysCheck" text="Keys received" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <Label fx:id="progressLabel" styleClass="progress"/>

        <VBox spacing="6">
            <Label text="Notes" styleClass="muted"/>
            <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true"
                      promptText="e.g. Small scratch on the rear bumper"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="12">
            <Button text="Save Inspection" styleClass="success" onAction="#handleSave"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </VBox>
</VBox>
